{
  "name": "charge-nearby",
  "version": "1.3.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.mjs",
    "check": "node --check html/app.js && node --check server.mjs && node --check lib/enbw.mjs",
    "check:badges": "node scripts/check-badges.mjs",
    "check:deployment": "node scripts/check-deployment.mjs",
    "test": "node --test tests/*.mjs",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude='tests/**' --test-coverage-lines=85 --test-coverage-branches=60 --test-coverage-functions=85 tests/*.mjs"
  }
}
