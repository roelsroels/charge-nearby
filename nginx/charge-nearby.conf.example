server {
    listen 80;
    server_name charge-nearby.example;

    root /var/www/charge-nearby/html;
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }

    location ~* \.(?:css|js|svg|png)$ {
        expires 7d;
        add_header Cache-Control "public, max-age=604800, immutable";
    }
}
