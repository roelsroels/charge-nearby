# Obtain the current browser key from the EnBW charging map network requests.
ENBW_API_KEY=replace-with-current-key

# Use 0.0.0.0 only when the service should be reachable on your private LAN.
HOST=0.0.0.0
PORT=8080

# Fresh cache: 60 seconds. Stale fallback: 15 minutes.
CACHE_TTL_MS=60000
STALE_TTL_MS=900000
